# ============ Base de datos (PostgreSQL en Neon) ============
# Los valores reales se piden por privado al responsable de la base de datos.
# NUNCA los escribas en este archivo.
# Usa el host DIRECTO de Neon (el que NO lleva "-pooler"): el pooler puede romper las migraciones.
DB_HOST=ep-xxxxxxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=tiendita_supermercado
DB_USERNAME=neondb_owner
DB_PASSWORD=
# Obligatorio: Neon rechaza conexiones sin SSL
DB_SSLMODE=require

# ============ Laravel ============
# Genera uno con: php artisan key:generate --show   (desde la carpeta backend)
APP_KEY=
APP_URL=http://localhost:8000

# ============ Stripe (modo test) ============
STRIPE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxx

# ============ Swagger ============
L5_SWAGGER_CONST_HOST=http://localhost:8000

# ============ Comportamiento del contenedor api ============
# Ejecuta "php artisan migrate" al arrancar. Con Neon solo crea la tabla de tokens
# de Sanctum si no existe; no toca las tablas del equipo.
RUN_MIGRATIONS=true
# Dejalo en false: la base de Neon ya trae categorias, marcas, productos y cupones.
RUN_SEED=false
# Regenera la documentacion Swagger al arrancar
GENERATE_SWAGGER=true

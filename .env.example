# ============ Base de datos (MySQL) ============
DB_DATABASE=final_api
# No uses "root" como usuario: la imagen de MySQL lo rechaza
DB_USERNAME=tiendita
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# ============ Laravel ============
# Genera uno con: php artisan key:generate --show   (desde la carpeta backend)
APP_KEY=
APP_URL=http://localhost:8000

# ============ Stripe (modo test) ============
STRIPE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxx

# ============ Swagger ============
L5_SWAGGER_CONST_HOST=http://localhost:8000/api

# ============ Comportamiento del contenedor api ============
# Ejecuta "php artisan migrate" al arrancar
RUN_MIGRATIONS=true
# Ejecuta los seeders al arrancar.
# (duplicaría productos y fallaría por el email único). Ver README.
RUN_SEED=false
# Regenera la documentación Swagger al arrancar
GENERATE_SWAGGER=true